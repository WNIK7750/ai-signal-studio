# Backend runtime
AI_SIGNAL_DATABASE_URL=sqlite:///data/ai-signal-studio.db
AI_SIGNAL_CORS_ORIGINS=["http://localhost:3000"]
AI_SIGNAL_TIMEZONE=Asia/Shanghai
# live = real RSS/GitHub defaults; demo = fixed test data; none = empty.
AI_SIGNAL_SOURCE_SEED_MODE=live

# AI analysis provider
# Keep "heuristic" to run fully offline.
# Set "openai_compatible" only after API key and model are configured.
AI_SIGNAL_LLM_PROVIDER=heuristic
AI_SIGNAL_LLM_API_KEY=
AI_SIGNAL_LLM_BASE_URL=https://api.openai.com/v1
AI_SIGNAL_LLM_MODEL=
AI_SIGNAL_LLM_TIMEOUT_SECONDS=30
AI_SIGNAL_LLM_MAX_OUTPUT_TOKENS=1200

# Local model registry and secret store. Both *.local.json files are Git ignored.
AI_SIGNAL_MODEL_CONFIG_PATH=config/models.local.json
AI_SIGNAL_MODEL_SECRETS_PATH=config/model-secrets.local.json

# Optional external source credentials
AI_SIGNAL_SEARCH_PROVIDER=brave
AI_SIGNAL_SEARCH_API_KEY=
AI_SIGNAL_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
AI_SIGNAL_GITHUB_TOKEN=
