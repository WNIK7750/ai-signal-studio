{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-signal-studio.local/contracts/05-models/model-config.schema.json",
  "title": "AI Signal Studio Model Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "provider",
    "provider_id",
    "provider_name",
    "model_id",
    "base_url",
    "has_api_key",
    "supports_vision",
    "output_token_limit",
    "enabled",
    "is_default"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^model_[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "provider": {
      "enum": ["heuristic", "openai_compatible"]
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_name": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "base_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "has_api_key": {
      "type": "boolean"
    },
    "supports_vision": {
      "type": "boolean"
    },
    "output_token_limit": {
      "type": ["integer", "null"],
      "minimum": 256
    },
    "enabled": {
      "type": "boolean"
    },
    "is_default": {
      "type": "boolean"
    }
  }
}
