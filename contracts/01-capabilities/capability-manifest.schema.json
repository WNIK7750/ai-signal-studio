{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-signal.local/schemas/capability-manifest-v1.json",
  "title": "Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "input_schema",
    "output_schema",
    "side_effect",
    "risk_level",
    "approval",
    "interfaces"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "input_schema": {
      "type": "string"
    },
    "output_schema": {
      "type": "string"
    },
    "side_effect": {
      "enum": [
        "none",
        "read",
        "write",
        "external"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "approval": {
      "enum": [
        "never",
        "required",
        "policy"
      ]
    },
    "required_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rest",
        "langchain_tool",
        "mcp_tool",
        "a2a_skill"
      ],
      "properties": {
        "rest": {
          "type": "boolean"
        },
        "langchain_tool": {
          "type": "boolean"
        },
        "mcp_tool": {
          "type": "boolean"
        },
        "a2a_skill": {
          "type": "boolean"
        }
      }
    },
    "limits_schema": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}